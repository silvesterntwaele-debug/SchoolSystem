@model SchoolSystem.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">

    <h2>Delete User</h2>

    <div class="alert alert-danger">

        <h4>Are you sure you want to delete this user?</h4>

    </div>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Username
        </dt>

        <dd class="col-sm-9">
            @Model.UserName
        </dd>

        <dt class="col-sm-3">
            Email
        </dt>

        <dd class="col-sm-9">
            @Model.Email
        </dd>

        <dt class="col-sm-3">
            Role
        </dt>

        <dd class="col-sm-9">
            @Model.Role
        </dd>

    </dl>

    <form asp-action="Delete">

        <input asp-for="Id" type="hidden" />

        <button class="btn btn-danger">
            Delete User
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
