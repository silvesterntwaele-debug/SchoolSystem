@model IEnumerable<StudentModuleMarkSheet>

@{
    ViewData["Title"] = "Student Module Marks";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Student Module Mark Sheets</h2>

            <p class="text-muted">

                @if (User.IsInRole("Admin"))
                {
                    <text>Manage all student module marks.</text>
                }
                else if (User.IsInRole("Lecturer"))
                {
                    <text>Manage marks for your students.</text>
                }
                else
                {
                    <text>View your academic results.</text>
                }

            </p>

        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Add Mark Sheet
            </a>
        }

    </div>

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Student Module Mark Sheets</h5>
        </div>

        <div class="card-body">

            <table class="table table-hover table-striped">

                <thead class="table-dark">

                    <tr>

                        <th>Student Number</th>

                        <th>Module</th>

                        <th>Final Mark</th>

                        <th>Result</th>

                        <th width="250">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Student?.StudentNumber
                            </td>

                            <td>
                                @item.Module?.Code
                            </td>

                            <td>
                                @item.FinalMark %
                            </td>

                            <td>

                                @if (item.FinalMark >= 50)
                                {
                                    <span class="badge bg-success">
                                        Pass
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Fail
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.StudentModuleMarkSheetId"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.StudentModuleMarkSheetId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.StudentModuleMarkSheetId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <hr />

    <div class="mt-3">

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-secondary">
                ← Back to Admin Dashboard
            </a>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <a asp-controller="Lecturer"
               asp-action="LecturerDashboard"
               class="btn btn-secondary">
                ← Back to Lecturer Dashboard
            </a>
        }
        else if (User.IsInRole("Student"))
        {
            <a asp-controller="Student"
               asp-action="StudentDashboard"
               class="btn btn-secondary">
                ← Back to Student Dashboard
            </a>
        }

    </div>

</div>