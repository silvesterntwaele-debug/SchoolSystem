@model IEnumerable<SchoolSystem.Models.StudentModuleMarkSheet>

@{
    ViewData["Title"] = "Student Module Mark Sheets";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Student Module Mark Sheets</h2>
            <p class="text-muted">
                View and manage student marks.
            </p>
        </div>

        <div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="AdminDashboard"
                   class="btn btn-secondary me-2">
                    ⬅ Back to Dashboard
                </a>

                <a asp-action="Create"
                   class="btn btn-primary">
                    ➕ Create Mark Sheet
                </a>
            }

            @if (User.IsInRole("Lecturer"))
            {
                <a asp-controller="Lecturer"
                   asp-action="LecturerDashboard"
                   class="btn btn-secondary me-2">
                    ⬅ Back to Dashboard
                </a>

                <a asp-action="Create"
                   class="btn btn-primary">
                    ➕ Create Mark Sheet
                </a>
            }

            @if (User.IsInRole("Student"))
            {
                <a asp-controller="Student"
                   asp-action="StudentDashboard"
                   class="btn btn-secondary">
                    ⬅ Back to Dashboard
                </a>
            }

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- SEARCH -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="input-group">

                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="Search Student Number or Module Code..." />

                    <button class="btn btn-primary">
                        🔍 Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Mark Sheets</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Student Number</th>

                            <th>Module</th>

                            <th>Exam</th>

                            <th>Final Mark</th>

                            <th>Updated</th>

                            <th width="250">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.Student?.StudentNumber</td>

                                    <td>@item.Module?.Code</td>

                                    <td>@item.Exam</td>

                                    <td>

                                        @if (item.FinalMark >= 50)
                                        {
                                            <span class="badge bg-success">
                                                @item.FinalMark%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                @item.FinalMark%
                                            </span>
                                        }

                                    </td>

                                    <td>@item.LastUpdated.ToShortDateString()</td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.StudentModuleMarkSheetId"
                                           class="btn btn-info btn-sm">
                                            Details
                                        </a>

                                        @if (!User.IsInRole("Student"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.StudentModuleMarkSheetId"
                                               class="btn btn-warning btn-sm">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.StudentModuleMarkSheetId"
                                               class="btn btn-danger btn-sm">
                                                Delete
                                            </a>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted">
                                    No mark sheets found.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>