@model IEnumerable<SchoolSystem.Models.Registration>

@{
    ViewData["Title"] = "Registrations";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Registrations</h2>

            <p class="text-muted">
                @if (User.IsInRole("Admin"))
                {
                    <text>Manage student module registrations.</text>
                }
                else
                {
                    <text>View module registrations.</text>
                }
            </p>

        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Register Student
            </a>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Registration List</h5>
        </div>

        <div class="card-body">

            <table class="table table-hover table-striped">

                <thead class="table-dark">

                    <tr>

                        <th>Student Number</th>

                        <th>Student Email</th>

                        <th>Module Code</th>

                        <th>Module Name</th>

                        <th>Semester</th>

                        <th>Registered On</th>

                        <th>Status</th>

                        <th width="260">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Student?.StudentNumber
                            </td>

                            <td>
                                @item.Student?.User?.Email
                            </td>

                            <td>
                                @item.Module?.Code
                            </td>

                            <td>
                                @item.Module?.Name
                            </td>

                            <td>
                                @item.Semester
                            </td>

                            <td>
                                @item.RegisteredOn.ToString("dd MMM yyyy")
                            </td>

                            <td>

                                <span class="badge bg-success">
                                    Registered
                                </span>

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.RegistrationId"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.RegistrationId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.RegistrationId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <hr />

    <div class="mt-3">

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-secondary">
                ← Back to Admin Dashboard
            </a>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <a asp-controller="Lecturer"
               asp-action="LecturerDashboard"
               class="btn btn-secondary">
                ← Back to Lecturer Dashboard
            </a>
        }
        else if (User.IsInRole("Student"))
        {
            <a asp-controller="Student"
               asp-action="StudentDashboard"
               class="btn btn-secondary">
                ← Back to Student Dashboard
            </a>
        }

    </div>

</div>