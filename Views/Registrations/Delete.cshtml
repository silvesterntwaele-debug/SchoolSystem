@model SchoolSystem.Models.Registration

@{
    ViewData["Title"] = "Delete Registration";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3>Delete Registration</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <h5>Are you sure you want to delete this registration?</h5>
                <p class="mb-0">
                    This action cannot be undone.
                </p>
            </div>

            <table class="table table-bordered">

                <tr>
                    <th width="30%">Student Number</th>
                    <td>@Model.Student?.StudentNumber</td>
                </tr>

                <tr>
                    <th>Module Code</th>
                    <td>@Model.Module?.Code</td>
                </tr>

                <tr>
                    <th>Module Name</th>
                    <td>@Model.Module?.Name</td>
                </tr>

                <tr>
                    <th>Semester</th>
                    <td>@Model.Semester</td>
                </tr>

                <tr>
                    <th>Registration Date</th>
                    <td>@Model.RegisteredOn.ToString("dd MMMM yyyy")</td>
                </tr>

            </table>

        </div>

        <div class="card-footer">

            <form asp-action="Delete">

                <input type="hidden" asp-for="RegistrationId" />

                <input type="submit"
                       value="Delete Registration"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>