@model SchoolSystem.Models.Registration

@{
    ViewData["Title"] = "Registration Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Registration Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Student Number
                </dt>

                <dd class="col-sm-9">
                    @Model.Student?.StudentNumber
                </dd>

                <dt class="col-sm-3">
                    Student Email
                </dt>

                <dd class="col-sm-9">
                    @Model.Student?.User?.Email
                </dd>

                <dt class="col-sm-3">
                    Module Code
                </dt>

                <dd class="col-sm-9">
                    @Model.Module?.Code
                </dd>

                <dt class="col-sm-3">
                    Module Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Module?.Name
                </dd>

                <dt class="col-sm-3">
                    Semester
                </dt>

                <dd class="col-sm-9">
                    @Model.Semester
                </dd>

                <dt class="col-sm-3">
                    Registered On
                </dt>

                <dd class="col-sm-9">
                    @Model.RegisteredOn.ToLongDateString()
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.RegistrationId"
                   class="btn btn-warning">
                    Edit
                </a>
            }

            <a asp-action="Index"
               class="btn btn-info">
                Back to List
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="AdminDashboard"
                   class="btn btn-secondary">
                    Dashboard
                </a>
            }

            @if (User.IsInRole("Lecturer"))
            {
                <a asp-controller="Lecturer"
                   asp-action="LecturerDashboard"
                   class="btn btn-secondary">
                    Dashboard
                </a>
            }

            @if (User.IsInRole("Student"))
            {
                <a asp-controller="Student"
                   asp-action="StudentDashboard"
                   class="btn btn-secondary">
                    Dashboard
                </a>
            }

        </div>

    </div>

</div>