@model SchoolSystem.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3>Delete Invoice</h3>
        </div>

        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this invoice?
            </h5>

            <hr />

            <table class="table">

                <tr>
                    <th>Student Number</th>
                    <td>@Model.Student?.StudentNumber</td>
                </tr>

                <tr>
                    <th>Description</th>
                    <td>@Model.Description</td>
                </tr>

                <tr>
                    <th>Amount Due</th>
                    <td>R @Model.AmountDue.ToString("N2")</td>
                </tr>

                <tr>
                    <th>Amount Paid</th>
                    <td>R @Model.AmountPaid.ToString("N2")</td>
                </tr>

                <tr>
                    <th>Balance</th>
                    <td>R @Model.Balance.ToString("N2")</td>
                </tr>

                <tr>
                    <th>Due Date</th>
                    <td>@Model.DueDate.ToShortDateString()</td>
                </tr>

            </table>

            <form asp-action="Delete">

                <input type="hidden" asp-for="InvoiceId" />

                <button class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>