@model IEnumerable<SchoolSystem.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Invoices</h2>
            <p class="text-muted">
                Manage and view student invoices.
            </p>
        </div>

        <div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="AdminDashboard"
                   class="btn btn-secondary me-2">
                    ⬅ Back to Dashboard
                </a>

                <a asp-action="Create"
                   class="btn btn-primary">
                    ➕ Create Invoice
                </a>
            }

            else if (User.IsInRole("Student"))
            {
                <a asp-controller="Student"
                   asp-action="StudentDashboard"
                   class="btn btn-secondary">
                    ⬅ Back to Dashboard
                </a>
            }

        </div>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- SEARCH BAR -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="input-group">

                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="Search by Invoice ID, Student Number, Amount or Date..." />

                    <button class="btn btn-primary" type="submit">
                        🔍 Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Invoice List
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Invoice ID</th>

                            @if (User.IsInRole("Admin"))
                            {
                                <th>Student Number</th>
                            }

                            <th>Amount</th>

                            <th>Created On</th>

                            <th width="250">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.InvoiceId
                                    </td>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td>
                                            @item.Student?.StudentNumber
                                        </td>
                                    }

                                    <td>
                                        @string.Format(new System.Globalization.CultureInfo("en-ZA"), "{0:C}", item.AmountDue)
                                    </td>

                                    <td>
                                        @item.CreatedOn.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.InvoiceId"
                                           class="btn btn-info btn-sm">
                                            Details
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.InvoiceId"
                                               class="btn btn-warning btn-sm">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.InvoiceId"
                                               class="btn btn-danger btn-sm">
                                                Delete
                                            </a>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="@(User.IsInRole("Admin") ? 5 : 4)"
                                    class="text-center text-muted">

                                    No invoices found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>