@model IEnumerable<SchoolSystem.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Invoices</h2>

            <p class="text-muted">
                @if (User.IsInRole("Admin"))
                {
                    <text>Manage all student invoices.</text>
                }
                else
                {
                    <text>View your invoices.</text>
                }
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Create Invoice
            </a>
        }

    </div>

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Invoice List</h5>
        </div>

        <div class="card-body">

            <table class="table table-hover table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>Student Number</th>
                        <th>Description</th>
                        <th>Amount Due</th>
                        <th>Amount Paid</th>
                        <th>Balance</th>
                        <th>Due Date</th>
                        <th width="250">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.Student?.StudentNumber</td>

                            <td>@item.Description</td>

                            <td>R @item.AmountDue.ToString("N2")</td>

                            <td>R @item.AmountPaid.ToString("N2")</td>

                            <td>
                                <strong>R @item.Balance.ToString("N2")</strong>
                            </td>

                            <td>@item.DueDate.ToString("dd MMM yyyy")</td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.InvoiceId"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.InvoiceId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.InvoiceId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <hr />

    <div class="mt-3">

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-secondary">
                ← Back to Admin Dashboard
            </a>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <a asp-controller="Lecturer"
               asp-action="LecturerDashboard"
               class="btn btn-secondary">
                ← Back to Lecturer Dashboard
            </a>
        }
        else if (User.IsInRole("Student"))
        {
            <a asp-controller="Student"
               asp-action="StudentDashboard"
               class="btn btn-secondary">
                ← Back to Student Dashboard
            </a>
        }

    </div>

</div>