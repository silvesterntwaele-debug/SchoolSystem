@model SchoolSystem.Models.Invoice

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Create Invoice</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="StudentId"></label>
                    <select asp-for="StudentId"
                            asp-items="ViewBag.StudentId"
                            class="form-select">
                        <option value="">-- Select Student --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"></label>
                    <input asp-for="Description" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="AmountDue"></label>
                    <input asp-for="AmountDue" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="AmountPaid"></label>
                    <input asp-for="AmountPaid" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="DueDate"></label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                </div>

                <button class="btn btn-success">
                    Save
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}