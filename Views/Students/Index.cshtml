@model IEnumerable<SchoolSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Students</h2>

            <p class="text-muted">

                @if (User.IsInRole("Admin"))
                {
                    <text>Manage all registered students.</text>
                }
                else if (User.IsInRole("Lecturer"))
                {
                    <text>View registered students.</text>
                }
                else
                {
                    <text>View your student profile.</text>
                }

            </p>

        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create Student
            </a>
        }

    </div>

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Student List</h5>
        </div>

        <div class="card-body">

            <table class="table table-hover table-striped align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Email</th>

                        <th>Student Number</th>

                        <th>Programme</th>

                        <th>Year</th>

                        <th width="280">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @(item.User?.Email ?? "No User Assigned")
                            </td>

                            <td>
                                @item.StudentNumber
                            </td>

                            <td>
                                @item.Program
                            </td>

                            <td>
                                @item.YearOfStudy
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.StudentId"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.StudentId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.StudentId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <hr />

    <div class="mt-3">

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-secondary">
                ← Back to Admin Dashboard
            </a>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <a asp-controller="Lecturer"
               asp-action="LecturerDashboard"
               class="btn btn-secondary">
                ← Back to Lecturer Dashboard
            </a>
        }
        else if (User.IsInRole("Student"))
        {
            <a asp-controller="Student"
               asp-action="StudentDashboard"
               class="btn btn-secondary">
                ← Back to Student Dashboard
            </a>
        }

    </div>

</div>