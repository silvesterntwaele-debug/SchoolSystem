@model SchoolSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Student Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @(Model.User?.Email ?? "No User Assigned")
                </dd>

                <dt class="col-sm-3">
                    Student Number
                </dt>

                <dd class="col-sm-9">
                    @Model.StudentNumber
                </dd>

                <dt class="col-sm-3">
                    Programme
                </dt>

                <dd class="col-sm-9">
                    @Model.Program
                </dd>

                <dt class="col-sm-3">
                    Year of Study
                </dt>

                <dd class="col-sm-9">
                    @Model.YearOfStudy
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.StudentId"
                   class="btn btn-warning">
                    Edit
                </a>
            }

            <a asp-action="Index"
               class="btn btn-info">
                Back to List
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="AdminDashboard"
                   class="btn btn-secondary">
                    ← Dashboard
                </a>
            }

            @if (User.IsInRole("Lecturer"))
            {
                <a asp-controller="Lecturer"
                   asp-action="LecturerDashboard"
                   class="btn btn-secondary">
                    ← Dashboard
                </a>
            }

        </div>

    </div>

</div>