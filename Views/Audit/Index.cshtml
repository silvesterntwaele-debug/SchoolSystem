@model IEnumerable<SchoolSystem.Models.Audit>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Audit Logs</h2>
            <p class="text-muted">
                View all activities performed within the School Management System.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="AdminDashboard"
           class="btn btn-secondary">
            ← Back to Admin Dashboard
        </a>

    </div>

    <!-- SEARCH -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="input-group">

                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="Search by Action, Entity, User or Details..." />

                    <button type="submit"
                            class="btn btn-primary">
                        🔍 Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                Audit Log History
            </h5>
        </div>

        <div class="card-body">

            <table class="table table-hover table-striped">

                <thead class="table-dark">

                    <tr>

                        <th>Date & Time</th>

                        <th>Action</th>

                        <th>Entity</th>

                        <th>Entity ID</th>

                        <th>Performed By</th>

                        <th>Details</th>

                        <th width="120">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Timestamp.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @item.Action
                                </td>

                                <td>
                                    @item.EntityName
                                </td>

                                <td>
                                    @item.EntityId
                                </td>

                                <td>
                                    @item.PerformedByUserId
                                </td>

                                <td>
                                    @item.Details
                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.AuditId"
                                       class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center text-muted">

                                No audit records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>