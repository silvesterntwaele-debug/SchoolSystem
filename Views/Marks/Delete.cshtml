@model SchoolSystem.Models.Mark

@{
    ViewData["Title"] = "Delete Mark";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3>Delete Mark</h3>
        </div>

        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this mark?
            </h5>

            <hr />

            <table class="table">

                <tr>
                    <th>Student</th>
                    <td>@Model.Student?.StudentNumber</td>
                </tr>

                <tr>
                    <th>Module</th>
                    <td>@Model.Module?.Code</td>
                </tr>

                <tr>
                    <th>Assessment Type</th>
                    <td>@Model.AssessmentType</td>
                </tr>

                <tr>
                    <th>Score</th>
                    <td>@Model.Score %</td>
                </tr>

            </table>

            <form asp-action="Delete">

                <input type="hidden" asp-for="MarkId" />

                <button class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>