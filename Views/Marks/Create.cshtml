@model SchoolSystem.Models.Mark

@{
    ViewData["Title"] = "Create Mark";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Create Mark</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="StudentId"></label>
                    <select asp-for="StudentId"
                            asp-items="ViewBag.StudentId"
                            class="form-select">
                        <option value="">-- Select Student --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="ModuleId"></label>
                    <select asp-for="ModuleId"
                            asp-items="ViewBag.ModuleId"
                            class="form-select">
                        <option value="">-- Select Module --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="AssessmentType"></label>
                    <select asp-for="AssessmentType"
                            asp-items="Html.GetEnumSelectList<AssessmentType>()"
                            class="form-select">
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Score"></label>
                    <input asp-for="Score" class="form-control" />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>

                <button class="btn btn-success">
                    Save
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}