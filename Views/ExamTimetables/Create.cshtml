@model SchoolSystem.Models.ExamTimetable

@{
    ViewData["Title"] = "Create Exam Timetable";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Create Exam Timetable</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="ModuleId" class="form-label"></label>
                    <select asp-for="ModuleId"
                            asp-items="ViewBag.ModuleId"
                            class="form-select">
                        <option value="">-- Select Module --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="ExamDate" class="form-label"></label>
                    <input asp-for="ExamDate" type="date" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="DurationMinutes" class="form-label"></label>
                    <input asp-for="DurationMinutes" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Venue" class="form-label"></label>
                    <input asp-for="Venue" class="form-control" />
                </div>

                <button class="btn btn-success">
                    Save
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}