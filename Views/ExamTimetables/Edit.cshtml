@model SchoolSystem.Models.ExamTimetable

@{
    ViewData["Title"] = "Edit Exam Timetable";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h3>Edit Exam Timetable</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input type="hidden" asp-for="ExamTimetableId" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="ModuleId"></label>
                    <select asp-for="ModuleId"
                            asp-items="ViewBag.ModuleId"
                            class="form-select">
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="ExamDate"></label>
                    <input asp-for="ExamDate" type="date" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="StartTime"></label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="DurationMinutes"></label>
                    <input asp-for="DurationMinutes" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Venue"></label>
                    <input asp-for="Venue" class="form-control" />
                </div>

                <button class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}