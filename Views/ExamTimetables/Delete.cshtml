@model SchoolSystem.Models.ExamTimetable

@{
    ViewData["Title"] = "Delete Exam Timetable";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3>Delete Exam Timetable</h3>
        </div>

        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this exam timetable?
            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">Module</dt>
                <dd class="col-sm-9">@Model.Module?.Code</dd>

                <dt class="col-sm-3">Exam Date</dt>
                <dd class="col-sm-9">@Model.ExamDate.ToShortDateString()</dd>

                <dt class="col-sm-3">Venue</dt>
                <dd class="col-sm-9">@Model.Venue</dd>

            </dl>

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="ExamTimetableId" />

                <button class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>