@model SchoolSystem.Models.Module

@{
    ViewData["Title"] = "Module Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Module Details</h2>
            <p class="text-muted">
                View module information.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Back to Module List
        </a>

    </div>

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                Module Information
            </h5>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Module Code
                </dt>

                <dd class="col-sm-9">
                    @Model.Code
                </dd>

                <dt class="col-sm-3">
                    Module Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Credits
                </dt>

                <dd class="col-sm-9">
                    @Model.Credits
                </dd>

                <dt class="col-sm-3">
                    Capacity
                </dt>

                <dd class="col-sm-9">
                    @Model.Capacity
                </dd>

                <dt class="col-sm-3">
                    Lecturer
                </dt>

                <dd class="col-sm-9">
                    @Model.Lecturer?.StaffNumber
                </dd>

                @if (Model.ExamTimetable != null)
                {
                    <dt class="col-sm-3">
                        Exam Date
                    </dt>

                    <dd class="col-sm-9">
                        @Model.ExamTimetable.ExamDate.ToShortDateString()
                    </dd>

                    <dt class="col-sm-3">
                        Venue
                    </dt>

                    <dd class="col-sm-9">
                        @Model.ExamTimetable.Venue
                    </dd>
                }

            </dl>

        </div>

        <div class="card-footer">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.ModuleId"
                   class="btn btn-warning">
                    Edit
                </a>
            }

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>