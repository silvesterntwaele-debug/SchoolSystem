@model IEnumerable<SchoolSystem.Models.Module>

@{
    ViewData["Title"] = "Modules";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Modules</h2>

            <p class="text-muted">
                @if (User.IsInRole("Admin"))
                {
                    <text>Manage all university modules.</text>
                }
                else
                {
                    <text>View available university modules.</text>
                }
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Create Module
            </a>
        }

    </div>

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Module List</h5>
        </div>

        <div class="card-body">

            <table class="table table-hover table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Credits</th>
                        <th>Capacity</th>
                        <th>Lecturer</th>
                        <th width="250">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.Code</td>

                            <td>@item.Name</td>

                            <td>@item.Credits</td>

                            <td>@item.Capacity</td>

                            <td>@item.Lecturer?.StaffNumber</td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.ModuleId"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.ModuleId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ModuleId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <hr />

    <div class="mt-3">

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-secondary">
                ← Back to Admin Dashboard
            </a>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <a asp-controller="Lecturer"
               asp-action="LecturerDashboard"
               class="btn btn-secondary">
                ← Back to Lecturer Dashboard
            </a>
        }
        else if (User.IsInRole("Student"))
        {
            <a asp-controller="Student"
               asp-action="StudentDashboard"
               class="btn btn-secondary">
                ← Back to Student Dashboard
            </a>
        }

    </div>

</div>