@model IEnumerable<SchoolSystem.Models.Module>

@{
    ViewData["Title"] = "Modules";
}

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Modules</h2>
            <p class="text-muted">
                View and manage all modules.
            </p>
        </div>

        <div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="AdminDashboard"
                   class="btn btn-secondary me-2">
                    ⬅ Back to Dashboard
                </a>

                <a asp-action="Create"
                   class="btn btn-primary">
                    ➕ Create Module
                </a>
            }

            else if (User.IsInRole("Lecturer"))
            {
                <a asp-controller="Lecturer"
                   asp-action="LecturerDashboard"
                   class="btn btn-secondary">
                    ⬅ Back to Dashboard
                </a>
            }

        </div>

    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- SEARCH -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="input-group">

                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="Search by Lecturer Staff Number..." />

                    <button class="btn btn-primary"
                            type="submit">
                        🔍 Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Module List
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Code</th>

                            <th>Module Name</th>

                            <th>Credits</th>

                            <th>Lecturer Staff Number</th>

                            <th width="250">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Code
                                    </td>

                                    <td>
                                        @item.Name
                                    </td>

                                    <td>
                                        @item.Credits
                                    </td>

                                    <td>
                                        @(item.Lecturer?.StaffNumber ?? "Not Assigned")
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.ModuleId"
                                           class="btn btn-info btn-sm">
                                            Details
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.ModuleId"
                                               class="btn btn-warning btn-sm">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.ModuleId"
                                               class="btn btn-danger btn-sm">
                                                Delete
                                            </a>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center text-muted">

                                    No modules found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>