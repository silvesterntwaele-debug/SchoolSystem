@model SchoolSystem.Models.Module

@{
    ViewData["Title"] = "Delete Module";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3>Delete Module</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-danger">

                <h5>
                    Are you sure you want to delete this module?
                </h5>

                <p>
                    This action cannot be undone.
                </p>

            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Module Code
                </dt>

                <dd class="col-sm-9">
                    @Model.Code
                </dd>

                <dt class="col-sm-3">
                    Module Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Credits
                </dt>

                <dd class="col-sm-9">
                    @Model.Credits
                </dd>

                <dt class="col-sm-3">
                    Capacity
                </dt>

                <dd class="col-sm-9">
                    @Model.Capacity
                </dd>

                <dt class="col-sm-3">
                    Lecturer
                </dt>

                <dd class="col-sm-9">
                    @Model.Lecturer?.StaffNumber
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="ModuleId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete Module
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>